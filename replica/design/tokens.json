  "pairs": [
    ["light-text", "light-bg"], ["light-text", "light-surface"], ["light-text", "light-surface-2"],
    ["light-text-muted", "light-bg"], ["light-text-muted", "light-surface"], ["light-text-muted", "light-surface-2"],
    ["light-on-accent", "light-accent"], ["light-accent-text", "light-bg"], ["light-accent-text", "light-surface"],
    ["light-on-gold", "light-gold"], ["light-gold-text", "light-bg"], ["light-gold-text", "light-surface"],
    ["light-on-sage", "light-sage"], ["light-sage-text", "light-bg"], ["light-sage-text", "light-surface"],
    ["light-danger", "light-bg"], ["light-danger", "light-surface"], ["light-on-danger", "light-danger"],
    ["light-success", "light-bg"], ["light-success", "light-surface"], ["light-on-success", "light-success"],
    ["light-warning", "light-bg"], ["light-warning", "light-surface"],
    ["light-border-input", "light-bg", "ui"], ["light-border-input", "light-surface", "ui"],
    ["light-focus", "light-bg", "ui"], ["light-focus", "light-surface", "ui"],
    ["light-accent", "light-bg", "ui"], ["light-accent", "light-surface-2", "ui"],

    ["dark-text", "dark-bg"], ["dark-text", "dark-surface"], ["dark-text", "dark-surface-2"],
    ["dark-text-muted", "dark-bg"], ["dark-text-muted", "dark-surface"], ["dark-text-muted", "dark-surface-2"],
    ["dark-on-accent", "dark-accent"], ["dark-accent-text", "dark-bg"], ["dark-accent-text", "dark-surface"],
    ["dark-on-gold", "dark-gold"], ["dark-gold-text", "dark-bg"], ["dark-gold-text", "dark-surface"],
    ["dark-on-sage", "dark-sage"], ["dark-sage-text", "dark-bg"], ["dark-sage-text", "dark-surface"],
    ["dark-danger", "dark-bg"], ["dark-danger", "dark-surface"], ["dark-on-danger", "dark-danger"],
    ["dark-success", "dark-bg"], ["dark-success", "dark-surface"], ["dark-on-success", "dark-success"],
    ["dark-warning", "dark-bg"], ["dark-warning", "dark-surface"],
    ["dark-border-input", "dark-bg", "ui"], ["dark-border-input", "dark-surface", "ui"],
    ["dark-focus", "dark-bg", "ui"], ["dark-focus", "dark-surface", "ui"],
    ["dark-accent", "dark-bg", "ui"], ["dark-accent", "dark-surface-2", "ui"]
