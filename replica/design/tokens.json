  "font": {
    "display": "Montserrat",
    "sans": "Inter",
    "_note": "Both open (SIL OFL), loaded with @expo-google-fonts. Montserrat matches the geometric caps of the logo wordmark; Inter is for body and UI text."
  },
  "type": {
    "caption": {"size": 12, "line": 16, "weight": 500, "family": "sans"},
    "label":   {"size": 14, "line": 20, "weight": 600, "family": "sans"},
    "body-sm": {"size": 14, "line": 20, "weight": 400, "family": "sans"},
    "body":    {"size": 16, "line": 24, "weight": 400, "family": "sans"},
    "heading": {"size": 18, "line": 24, "weight": 700, "family": "display"},
    "title":   {"size": 22, "line": 28, "weight": 700, "family": "display"},
    "display": {"size": 30, "line": 36, "weight": 800, "family": "display"}
  },
  "space": {"0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64},
  "radius": {"sm": 8, "md": 12, "lg": 16, "xl": 24, "pill": 999},
  "shadow": {
    "card": {"offsetY": 1, "blur": 3, "opacity": 0.08},
    "pop": {"offsetY": 8, "blur": 24, "opacity": 0.18}
  },
  "opacity": {"scrim": 0.55, "disabled": 0.45, "pressed": 0.85},
  "motion": {"fast": 120, "base": 200, "slow": 320},
  "layout": {
    "gutter": 16,
    "max-content": 640,
    "touch-min": 44,
    "header": 56,
    "tab-bar": 60,
    "control-sm": 36,
    "control-md": 44,
    "control-lg": 52
  }
}
