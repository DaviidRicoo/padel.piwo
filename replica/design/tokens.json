{
  "_about": "Design tokens for Padel & Piwo. Roles, not colours: every component uses a role name, never a hex value. Two themes with the same role names. Brand colours were measured from image/logo.jpg (navy #11334F, gold #C79649, sage #8BB1A4). Playtomic screenshots were not available, so the scale, spacing and radius are standard mobile values, not measured from the original. After any change: python replica/design/build_tokens.py && python <replica-design>/contrast.py replica/design/tokens.json",
  "color": {
    "light": {
      "bg": "#FFFFFF",
      "surface": "#F4F6F9",
      "surface-2": "#E8EDF3",
      "border": "#D5DCE5",
      "border-input": "#74808F",
      "text": "#11334F",
      "text-muted": "#4A5D72",
      "accent": "#11334F",
      "on-accent": "#FFFFFF",
      "accent-text": "#11334F",
      "gold": "#C79649",
      "on-gold": "#11334F",
      "gold-text": "#85601F",
      "sage": "#8BB1A4",
      "on-sage": "#11334F",
      "sage-text": "#3B6A5B",
      "danger": "#B42318",
      "on-danger": "#FFFFFF",
      "success": "#1E7A4C",
      "on-success": "#FFFFFF",
      "warning": "#8F5F00",
      "focus": "#11334F",
      "scrim": "#0B1F33"
    },
    "dark": {
      "bg": "#11334F",
      "surface": "#18405F",
      "surface-2": "#1F4C70",
      "border": "#2C5A80",
      "border-input": "#8AA3BC",
      "text": "#FFFFFF",
      "text-muted": "#BFCCDA",
      "accent": "#C79649",
      "on-accent": "#11334F",
      "accent-text": "#DDB46E",
      "gold": "#C79649",
      "on-gold": "#11334F",
      "gold-text": "#DDB46E",
      "sage": "#8BB1A4",
      "on-sage": "#11334F",
      "sage-text": "#9CC4B6",
      "danger": "#FF8A7A",
      "on-danger": "#11334F",
      "success": "#6ED3A1",
      "on-success": "#11334F",
      "warning": "#F2C46B",
      "focus": "#DDB46E",
      "scrim": "#000000"
    }
