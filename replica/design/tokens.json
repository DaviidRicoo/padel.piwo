  "font": {
    "display": "Montserrat",
    "sans": "Inter",
    "_note": "Both open (SIL OFL), loaded with @expo-google-fonts. Inter carries every screen, with tight tracking on headings (an Apple-style hierarchy, from the awesome-design-md 'apple' DESIGN.md). Montserrat is kept only for the brand variant, because it matches the geometric caps of the logo wordmark."
  },
  "type": {
    "caption": {"size": 12, "line": 16, "weight": 500, "family": "sans", "tracking": 0},
    "label":   {"size": 15, "line": 20, "weight": 600, "family": "sans", "tracking": -0.2},
    "body-sm": {"size": 14, "line": 20, "weight": 400, "family": "sans", "tracking": -0.1},
    "body":    {"size": 16, "line": 24, "weight": 400, "family": "sans", "tracking": -0.2},
    "heading": {"size": 17, "line": 22, "weight": 600, "family": "sans", "tracking": -0.3},
    "title":   {"size": 21, "line": 26, "weight": 700, "family": "sans", "tracking": -0.4},
    "display": {"size": 30, "line": 36, "weight": 700, "family": "sans", "tracking": -0.8},
    "brand":   {"size": 26, "line": 32, "weight": 800, "family": "display", "tracking": -0.2}
  },
  "space": {"0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64},
  "radius": {"sm": 8, "md": 12, "lg": 18, "xl": 24, "pill": 999},
  "shadow": {
    "card": {"offsetY": 1, "blur": 2, "opacity": 0.05},
    "pop": {"offsetY": 8, "blur": 24, "opacity": 0.18}
  },
  "opacity": {"scrim": 0.55, "disabled": 0.45, "pressed": 0.85},
  "scale": {"pressed": 0.97},
  "motion": {"fast": 120, "base": 200, "slow": 320},
  "layout": {
    "gutter": 16,
    "max-content": 640,
    "touch-min": 44,
    "header": 56,
    "tab-bar": 60,
    "control-sm": 36,
    "control-md": 44,
    "control-lg": 52
  }
