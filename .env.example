# Copy the app part to .env.local and the CLI part to supabase/.env, then fill in
# the values. Neither file is committed (.gitignore). Never put a secret key in an
# EXPO_PUBLIC_ variable: those are built into the app and anyone can read them.

# ---------------------------------------------------------------- app (.env.local)
# Supabase dashboard > Project Settings > API keys
EXPO_PUBLIC_SUPABASE_URL=
# the publishable key (sb_publishable_...), safe to ship in the app; row level security protects the data
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# EAS project id, needed for push tokens (after "npx eas-cli@latest init"); optional until then
EXPO_PUBLIC_EAS_PROJECT_ID=
# fake data layer only: start signed in as a seed account (ignored when Supabase is set)
EXPO_PUBLIC_DEMO_USER=

# ---------------------------------------------------------------- Supabase CLI (supabase/.env)
# Gmail account that sends the auth emails, and its 16-character app password
# (Google Account > Security > 2-Step Verification > App passwords). Used by
# "npx supabase config push".
SMTP_USER=
SMTP_PASS=

# ---------------------------------------------------------------- seed script only (your shell, never a file in the app)
# Only for scripts/seed-supabase.ts, run against a test project. The secret key
# (sb_secret_...) bypasses row level security: keep it out of the app and out of git.
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=
# SEED_CONFIRM=yes
